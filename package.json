{
  "name": "civitai-metadata-studio-app-block",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Hosted Civitai App Block for lossless AI image metadata inspection, verification, and editing.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chriscollins500/civitai-metadata-studio-app-block.git"
  },
  "bugs": {
    "url": "https://github.com/chriscollins500/civitai-metadata-studio-app-block/issues"
  },
  "homepage": "https://civitai.com/apps/run/civitai-metadata-studio",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-release.mjs",
    "check": "node scripts/check.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && node scripts/verify-app-block.mjs",
    "verify:schema": "npm run build && node scripts/verify-app-block.mjs --schema",
    "reproduce": "npm run verify && node scripts/reproduce-release.mjs",
    "verify:live": "npm run verify && node --use-system-ca scripts/reproduce-release.mjs --live",
    "preview": "node scripts/serve-app-block-preview.mjs",
    "test:browser": "npm run build && node scripts/build-browser-reference.mjs && node scripts/test-app-block-browser.mjs",
    "ci": "npm run check && npm run docs:check && npm test && npm run verify"
  }
}
